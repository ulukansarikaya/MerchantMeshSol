# ---- Mode toggles (mock-first; all default to the mock path) ----
MOCK_PAYMENTS=true
MOCK_CHAIN=true
AUTO_ACCEPT_MERCHANT_ORDERS=true
AI_PROVIDER=mock            # mock | agy | agy-cli

# ---- AGY (Antigravity) — used when AI_PROVIDER=agy ----
AGY_BASE_URL=http://localhost:8080/v1
AGY_API_KEY=
AGY_MODEL=agy-default
# Faz 3 — merchant-side discount-proposal call (apps/merchant-agents/src/discountProvider.ts)
# aborts and falls back to the plain deterministic quote past this many ms.
AGY_TIMEOUT_MS=8000

# ---- Service URLs / ports ----
WEB_PORT=3000
BRIDGE_PORT=3001
MERCHANTS_PORT=4000
BRIDGE_URL=http://localhost:3001
MERCHANTS_URL=http://localhost:4000

# ---- Research budget (integer micro-USDC) ----
RESEARCH_BUDGET_TOTAL_MICRO=10000       # 0.01 USDC
RESEARCH_BUDGET_PER_REQUEST_MICRO=2000  # 0.002 USDC

# ---- Mock payment proof secret (shared between bridge and merchants) ----
MOCK_PAYMENT_SECRET=merchantmesh-mock-secret

# ---- Chain (Solana; used when MOCK_CHAIN=false) ----
# Never hardcode a cluster name/RPC URL in code — everything reads from
# these. Solana has no numeric chain id (unlike EVM) — the cluster name +
# RPC URL is the whole identity (see packages/shared/src/solanaConfig.ts).
# In mock mode these are not read at all (no network call happens either
# way), so leaving devnet values here is harmless; just keep MOCK_CHAIN=true.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet        # localnet | devnet | testnet | mainnet-beta
SOLANA_EXPLORER_URL=https://explorer.solana.com
CHAIN_MIN_CONFIRMATIONS=1
# Devnet USDC mint (SPL Token) — 6 decimals, matches this repo's micro-USDC
# convention everywhere. Program ids (order_escrow, merchant_directory,
# order_receipt) are NOT env-configurable — they're fixed at build time in
# /solana's `declare_id!`/IDL and imported straight from
# @merchantmesh/shared's solana/programIds.ts, unlike an EVM contract address.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Hex-encoded 32-byte Ed25519 seed (freshly generated deploy/relayer key —
# never a dev key from packages/shared/src/solanaKeys.ts, never committed).
RELAYER_PRIVATE_KEY=

# ---- Real mode: x402 facilitator (used when MOCK_PAYMENTS=false) ----
X402_FACILITATOR_URL=

# ---- Live-version data infra (Faz A — unused until packages/db lands) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/merchantmesh
REDIS_URL=redis://localhost:6379

# ---- Session wallet (Faz J — unused until wired; testnet pilot only) ----
SESSION_WALLET_MASTER_KEY=      # 32-byte key, base64-encoded — never commit a real value
TESTNET_ONLY=true
SESSION_WALLET_MAX_BALANCE_MICRO=1000000  # 1.00 USDC hedef/maksimum bakiye
SESSION_WALLET_PER_TASK_MICRO=10000       # 0.01 USDC otomatik harcama / görev
SESSION_WALLET_PER_DAY_MICRO=1000000      # 1.00 USDC otomatik harcama / gün
MAX_PAYMENTS_PER_TASK=8
MAX_PAID_MERCHANTS=3

# ---- Web (browser-side) ----
# NEXT_PUBLIC_MOCK=true keeps the old simulated-wallet widget and skips the
# wallet-gate on the shopping flow; set to false once platform-api + Postgres
# are wired up (Faz C) to use real Solana wallet-adapter login instead (see
# apps/web/lib/solanaConfig.ts and app/providers.tsx).
NEXT_PUBLIC_MOCK=true
NEXT_PUBLIC_BRIDGE_URL=http://localhost:3001
NEXT_PUBLIC_MERCHANTS_URL=http://localhost:4000
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:3002
# Mirrors of SOLANA_* above — Next.js only inlines NEXT_PUBLIC_*-prefixed vars
# into the browser bundle, so these are duplicated by hand (see lib/solanaConfig.ts).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Leave unset so the browser uses this app's /api/rpc proxy, which forwards to
# SOLANA_RPC_URL server-side. Setting a public endpoint here works but rate-limits
# (429) when one approval funds several escrows; setting the keyed provider URL here
# would publish the API key in the browser bundle.
#NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_EXPLORER_URL=https://explorer.solana.com
# Faz I §4 — funding wizard's SPL transfer target; mirrors USDC_MINT above.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---- Platform API (Faz C — Solana wallet sign-in) ----
PLATFORM_API_PORT=3002
WEB_ORIGIN=http://localhost:3000
# Faz 2/3 — self-service merchant CRUD + operator admin surface (publish,
# suspend/activate, dispute resolution). Comma-separated accountIds (uuid,
# from the `accounts` table) that are allowed to call the operator-only
# routes. Empty = nobody is an operator, /merchant-agents/:id/publish and
# /admin/* just 403. RELAYER_PRIVATE_KEY above doubles as the signer for
# these on-chain calls (list_merchant/set_merchant_wallet/resolve) — if
# unset, the whole /merchant-agents + /admin/* + dispute route surface is
# absent from platform-api entirely (not just gated).
PLATFORM_OPERATOR_ACCOUNT_IDS=

# ---- Agent knobs ----
DISCOVERY_RADIUS_M=1000

# ---- Demo knobs ----
DEMO_FAIL_SHOP=             # e.g. mini-market → scripted escrow-funding failure for that shop
DEMO_PREP_TIMEOUT=false     # true → one shop never marks ready, auto-refund fires
DEMO_PREP_TIMEOUT_SHOP=cem-firin
DEMO_PREP_TIMEOUT_SECS=6    # short release deadline used by the timeout demo

# ---- Merchant signer keys (real mode; mock mode uses the deterministic dev
# seeds in packages/shared/src/solanaKeys.ts). Hex-encoded 32-byte Ed25519 seeds.
MERCHANT_ALI_KASAP_PRIVATE_KEY=
MERCHANT_CAN_KASAP_PRIVATE_KEY=
MERCHANT_ZEYNEP_MANAV_PRIVATE_KEY=
MERCHANT_CEM_FIRIN_PRIVATE_KEY=
MERCHANT_MINI_MARKET_PRIVATE_KEY=
